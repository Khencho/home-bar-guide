---
import { renderChapters } from '../../lib/markdown';
import { getAllArticles } from '../../lib/store';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE, CATEGORIES } from '../../consts';

export const prerender = false;

const { cat } = Astro.params;
const current = CATEGORIES.find((c) => c.slug === cat);
if (!current) return Astro.redirect('/');

const posts = (await getAllArticles())
  .filter((p) => (p.category || 'Статьи') === current.title)
  .sort((a, b) => Number(b.pinned) - Number(a.pinned) || (a.pubDate < b.pubDate ? 1 : -1));

const rendered = posts.map((p) => ({ ...p, html: renderChapters(p.body || '') }));
---

<BaseLayout title={`${current.title} — ${SITE_TITLE}`}>
  <section class="cat-banner" style={`background-image:url('${current.image}')`}>
    <div class="container">
      <h1>{current.title}</h1>
      <p class="post-meta">Материалы в разделе «{current.title}»</p>
    </div>
  </section>

  <section class="container block">
    {rendered.length === 0 ? (
      <p>Скоро здесь появятся материалы.</p>
    ) : (
      rendered.map(({ title, description, html, slug }) => (
        <article class="cat-article">
          <h2 id={slug}>{title}</h2>
          {description && <p class="post-meta">{description}</p>}
          <div class="prose" set:html={html} />
          <hr class="cat-sep" />
        </article>
      ))
    )}
    <p style="margin-top:28px"><a href="/">← На главную</a></p>
  </section>
</BaseLayout>
