---
import { getAllArticles } from '../lib/store';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, CATEGORIES } from '../consts';

export const prerender = false;

const posts = await getAllArticles();
const countByCat = (title: string) => posts.filter((p) => (p.category || 'Статьи') === title).length;
---

<BaseLayout title={SITE_TITLE}>
  <section class="hero">
    <div class="container">
      <h1>{SITE_TITLE}</h1>
      <p class="post-meta">Гид по домашнему бару и напиткам: рецепты коктейлей, настоек и безалкогольных напитков, чай и кофе по-домашнему.</p>
    </div>
  </section>

  <section class="container">
    <div class="cat-grid">
      {CATEGORIES.map((cat) => (
        <a class="cat-tile" href={`/category/${cat.slug}`}>
          <span class="cat-name">{cat.title}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
